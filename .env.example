# ===========================================================================
# The Lenny Growth Assistant - environment configuration
# ===========================================================================
# Copy this file to `.env` in the repository root and fill in real values:
#
#   cp .env.example .env
#
# The backend reads `.env` from the repository root.
# `.env` is git-ignored and must never contain values that are committed.
#
# Only variables required by the implemented phases are listed here.
# ===========================================================================

# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL or Railway PostgreSQL)
# ---------------------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the "Session pooler" / direct connection string for migrations.
# Both `postgresql://` and `postgresql+psycopg2://` forms are accepted; the
# backend normalises the URL for SQLAlchemy.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
# Supabase connection strings may include `?sslmode=require`. That is supported.
# A `pgbouncer=true` parameter is stripped automatically (not valid for psycopg2).

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
# development | production
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
# Used by the browser to reach the API. For local development, copy this line
# into `frontend/.env.local`. If unset, the frontend defaults to
# http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Transcript knowledge base (Phase 2 - ingestion)
# ---------------------------------------------------------------------------
# Location of the local clone of the dataset repository:
#   git clone https://github.com/ChatPRD/lennys-podcast-transcripts
# The clone must live outside this repository; the path may be relative
# (resolved from the repository root) or absolute.
TRANSCRIPTS_PATH=../lennys-podcast-transcripts

# Embedding provider and model. The PostgreSQL vector dimension is tied to the
# selected model and is recorded in docs/architecture.md.
#   sentence-transformers -> local model, no API key (default)
#   openai                -> cloud API, requires OPENAI_API_KEY
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Texts per embedding call. Lower it on memory-constrained machines.
EMBEDDING_BATCH_SIZE=64

# Chunking. Both values are tokens counted with the selected embedding model's
# tokenizer (bge-small-en-v1.5 accepts at most 512 tokens per text).
CHUNK_SIZE=400
CHUNK_OVERLAP=60

# Only required when EMBEDDING_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# LLM providers (Phase 3 - application agent)
# ---------------------------------------------------------------------------
# Which provider the application agent uses. Switching only requires changing
# this value; there is no automatic fallback between providers.
#   ollama -> local model execution through Ollama (default)
#   cloud  -> Anthropic cloud model execution
# `local` is accepted as an alias of `ollama`.
LLM_MODE=ollama

# Request timeout in seconds for a single provider call. A small local model
# running on CPU can need far longer than a cloud call: 1800 is a workable
# value for `qwen3:4b` on a laptop, while 120 suits a hosted provider.
LLM_TIMEOUT_SECONDS=120

# Cloud mode (LLM_MODE=cloud). Never commit a real key.
# Get a key from https://console.anthropic.com/ and export it as ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
# Any model alias supported by the Anthropic API, e.g. claude-sonnet-4-5.
ANTHROPIC_MODEL=claude-sonnet-4-5
# Upper bound on generated tokens per request.
ANTHROPIC_MAX_TOKENS=2048

# Local mode (LLM_MODE=ollama). See the README for installing Ollama and
# pulling a model, for example: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Optional context window for the local runtime. 0 keeps Ollama's default
# (4096 tokens for most models), which is well below what larger-context models
# support. Raising it costs RAM for the KV cache, so leave it at 0 unless a
# request genuinely needs a longer prompt plus answer.
OLLAMA_NUM_CTX=0

# Optional: let the configured provider classify request intent instead of the
# deterministic built-in classifier. Off by default so routing stays offline
# and free of API cost.
LLM_ROUTER_LLM_CLASSIFICATION=false
